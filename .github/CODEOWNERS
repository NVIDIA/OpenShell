# No wildcard rule. The maintainer-approval workflow checks maintainer reviews.
# Explicit ownership below protects the review and CI machinery.

## Merge enforcement — these paths decide who can merge, so they notify the full
# list of maintainers to raise scrutiny on changes here.
#
# PR checks run local to the branch, so unless the check specifically avoids
# using branch-local files, a PR could change its own gates and appear to pass
# them. Covering the required checks here closes that gap.
#
# The whole workflows directory is covered, not just the approval gate, because
# any workflow can claim a required check context or ask for a broader token.

# Core check mechanisms
/.github/workflows/ @ai-openshell/maintainers
/.github/actions/ @ai-openshell/maintainers
/.github/CODEOWNERS @ai-openshell/maintainers
/.github/zizmor.yml @ai-openshell/maintainers

# `MAINTAINERS.md` maintainer approval checks
/MAINTAINERS.md @ai-openshell/maintainers
/tasks/scripts/check_maintainer_approval.py @ai-openshell/maintainers
/tasks/scripts/alert_maintainer_change.py @ai-openshell/maintainers
/tasks/scripts/check_maintainer_approval_test.py @ai-openshell/maintainers
/tasks/scripts/alert_maintainer_change_test.py @ai-openshell/maintainers

# Reviewer routing registry and helper
/REVIEWERS.md @ai-openshell/maintainers
/tasks/scripts/check_review_readiness.py @ai-openshell/maintainers
/tasks/scripts/check_review_readiness_test.py @ai-openshell/maintainers
/tasks/scripts/check_reviewer_collaborators.py @ai-openshell/maintainers
/tasks/scripts/check_reviewer_collaborators_test.py @ai-openshell/maintainers

# PR issue acceptance checks
/tasks/scripts/check_issue_acceptance.cjs @ai-openshell/maintainers
/tasks/scripts/check_issue_acceptance.test.cjs @ai-openshell/maintainers

# Accepted-work classification
/tasks/scripts/label_accepted_work.py @ai-openshell/maintainers
/tasks/scripts/label_accepted_work_test.py @ai-openshell/maintainers

# Auditable SBOM check
/tasks/scripts/verify-image-sbom.sh @ai-openshell/maintainers
