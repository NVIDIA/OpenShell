load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "z3",
    srcs = glob(
        ["src/**/*.cpp"],
        exclude = [
            "src/api/julia/**",
            "src/shell/**",
            "src/test/**",
        ],
    ),
    hdrs = glob([
        "src/**/*.def",
        "src/**/*.h",
        "src/**/*.hpp",
    ]),
    copts = ["-std=c++20"],
    defines = [
        "NDEBUG",
        "_EXTERNAL_RELEASE",
        "_MP_INTERNAL",
    ],
    includes = [
        "src",
        "src/api",
    ],
    linkopts = select({
        "@platforms//os:linux": [
            "-ldl",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
)
