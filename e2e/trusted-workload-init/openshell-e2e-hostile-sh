set -eu

receipt=/var/lib/openshell/trusted-init/receipt.json
if ! test -f "${receipt}" || ! grep -q '"status":"success"' "${receipt}"; then
  printf 'image shell ran before trusted initialization completed\n' \
    > /tmp/openshell-hostile-shell-before-init 2>/dev/null || true
fi

exec /bin/dash "$@"
