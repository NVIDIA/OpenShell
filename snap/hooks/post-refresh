# Replace insecure gateway configs on refresh. Revisions that used
# refresh-mode: endure leave their plaintext gateway running through the
# refresh, so restart it to apply the new config. With refresh-mode: restart,
# snapd has already stopped the gateway and starts it after this hook; a
# second restart would only interrupt sandboxes again.

set -eu

gateway="${SNAP_INSTANCE_NAME}.gateway"

"${SNAP}/meta/hooks/install"
if snapctl services "$gateway" | awk 'NR == 2 { exit $3 != "active" }'; then
	snapctl restart "$gateway"
fi
