            "requirement": "optional",
            "object_type": "key_value_object",
            "object_name": "Key:Value object",
            "caption": "Tags"
        }
    },
    "name": "service",
    "description": "The Service object describes characteristics of a service, <code> e.g. AWS EC2. </code>",
    "extends": "_entity",
    "constraints": {
        "at_least_one": [
            "name",
            "uid"
        ]
    },
    "references": [
        {
            "description": "D3FEND\u2122 Ontology d3f:ServiceApplication.",
