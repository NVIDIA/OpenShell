load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_proc_macro")

# A proc-macro is always a dylib loaded by rustc on the exec platform, and the
# zig musl toolchain ships no shared unwinder (libgcc_s), so a musl build of
# this target is unlinkable and meaningless. Consumers are unaffected:
# proc_macro_deps builds it for the exec platform.
rust_proc_macro(
    name = "openshell_server_macros",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    target_compatible_with = select({
        "@zig_sdk//libc:musl": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)
