load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "openshell_supervisor_process",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(
        ["src/skills/**"],
        exclude = ["**/*.rs"],
    ),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        "//crates/openshell-core:openshell_core",
        "//crates/openshell-ocsf:openshell_ocsf",
        "//crates/openshell-policy:openshell_policy",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "openshell_supervisor_process_test",
    crate = ":openshell_supervisor_process",
    deps = all_crate_deps(normal_dev = True),
)
