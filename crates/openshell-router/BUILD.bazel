load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "openshell_router",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        "//crates/openshell-core:openshell_core",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "openshell_router_test",
    crate = ":openshell_router",
    deps = all_crate_deps(normal_dev = True),
)

# Cargo-style integration test: its own crate linked against the library.
rust_test(
    name = "backend_integration_test",
    srcs = ["tests/backend_integration.rs"],
    edition = "2024",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":openshell_router",
        "//crates/openshell-core:openshell_core",
    ],
)
