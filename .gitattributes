# Mark auto-generated protobuf files so GitHub linguist ignores them in
# diffs, stats, and language detection.

# Generated Python protobuf stubs
python/ryno/_proto/*_pb2.py linguist-generated
python/ryno/_proto/*_pb2_grpc.py linguist-generated
python/ryno/_proto/*_pb2.pyi linguist-generated

# Generated Rust protobuf code (excludes hand-written mod.rs)
crates/ryno-core/src/proto/ryno.*.rs linguist-generated

# Vendored OCSF schemas fetched from schema.ocsf.io
crates/ryno-ocsf/schemas/** linguist-generated
