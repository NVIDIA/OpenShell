[Unit]
Description=OpenShell tmachine CDI Unix socket fixture

[Socket]
ListenStream=/var/lib/openshell-test-inputs/cdi/scenarios/socket/echo.sock
SocketMode=0666
Accept=yes
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
