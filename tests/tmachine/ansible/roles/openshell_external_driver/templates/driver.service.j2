[Unit]
Description=OpenShell {{ openshell_external_driver_name }} compute driver (external)
After={{ openshell_external_driver_requires }}
Requires={{ openshell_external_driver_requires }}

[Service]
User={{ openshell_gateway_user }}
{% if openshell_external_driver_supplementary_groups | default('') %}
SupplementaryGroups={{ openshell_external_driver_supplementary_groups }}
{% endif %}
RuntimeDirectory=openshell-driver-{{ openshell_gateway_driver }}
Environment=OPENSHELL_SANDBOX_RUNTIME_IMAGE=docker.io/openshell/sandbox:tmachine
Environment=OPENSHELL_SUPERVISOR_IMAGE=docker.io/openshell/supervisor:tmachine
{% for entry in openshell_external_driver_environment | default([]) %}
Environment={{ entry }}
{% endfor %}
ExecStart=/usr/local/bin/{{ openshell_external_driver_binary_name }} \
  --bind-socket {{ openshell_external_driver_socket }}{% for arg in openshell_external_driver_args %} \
  {{ arg }}{% endfor %}

Restart=on-failure

[Install]
WantedBy=multi-user.target
