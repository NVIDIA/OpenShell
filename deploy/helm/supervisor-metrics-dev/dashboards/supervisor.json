{
  "uid": "openshell-supervisor-poc",
  "title": "OpenShell supervisor metrics — local experiment",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "openshell",
    "proof-of-concept"
  ],
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Assigned sandboxes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "supervisor-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, phase) (openshell_supervisor_sandboxes)",
          "legendFormat": "{{pod}} {{phase}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Open runtime control connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "supervisor-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
