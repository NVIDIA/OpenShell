      "targets": [
        {
          "refId": "A",
          "expr": "openshell_supervisor_gateway_connected",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Scrape health (1 = reachable)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "supervisor-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"openshell-supervisor\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Network decision rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "supervisor-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, layer, outcome) (rate(openshell_supervisor_network_decisions_total[$__rate_interval]))",
          "legendFormat": "{{pod}} {{layer}} {{outcome}}"
        }
      ]
    },
    {
      "id": 6,
