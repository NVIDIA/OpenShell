        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "openshell_supervisor_runtime_connections",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Gateway connected (1 = accepted)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "supervisor-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
