        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (pod, le) (rate(openshell_supervisor_policy_update_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
