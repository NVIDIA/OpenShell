      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "supervisor-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
